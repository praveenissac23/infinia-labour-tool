<?xml version="1.0" encoding="UTF-8"?>
<!--
  Runs the backup every morning at 9:00.

  Install:
    mkdir -p ~/Library/LaunchAgents
    cp com.infinia.backup.plist ~/Library/LaunchAgents/
    # edit the path below to wherever you saved backup-to-mac.sh
    launchctl unload ~/Library/LaunchAgents/com.infinia.backup.plist 2>/dev/null
    launchctl load  ~/Library/LaunchAgents/com.infinia.backup.plist

  Check it is scheduled:   launchctl list | grep infinia
  Run it right now:        launchctl start com.infinia.backup

  If the Mac is asleep or off at 9:00, launchd runs the job as soon as
  it wakes - a missed morning still gets its backup.
-->
<plist version="1.0">
<dict>
    <key>Label</key>
    <string>com.infinia.backup</string>

    <key>ProgramArguments</key>
    <array>
        <string>/bin/bash</string>
        <!-- CHANGE THIS to where you saved the script -->
        <string>/Users/YOURNAME/Scripts/backup-to-mac.sh</string>
    </array>

    <key>StartCalendarInterval</key>
    <dict>
        <key>Hour</key><integer>9</integer>
        <key>Minute</key><integer>0</integer>
    </dict>

    <!-- Catch up after the Mac was asleep at 9:00 -->
    <key>RunAtLoad</key>
    <false/>

    <key>StandardOutPath</key>
    <string>/tmp/infinia-backup.out</string>
    <key>StandardErrorPath</key>
    <string>/tmp/infinia-backup.err</string>
</dict>
</plist>
